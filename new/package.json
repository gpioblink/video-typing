{
  "name": "video-typing-extension",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "CHOKIDAR_USEPOLLING=1 wxt build",
    "build:release": "node ./scripts/build-release.mjs",
    "zip": "wxt zip",
    "test": "node --loader ./test/ts-loader.mjs --test ./test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev:web": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "build:web": "vite build --config vite.demo.config.ts",
    "preview:web": "vite preview --config vite.demo.config.ts --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:youtube": "LIVE_YOUTUBE=1 playwright test --grep 'real official YouTube'"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@wxt-dev/module-react": "^1.1.1",
    "eslint": "^10.14.0",
    "typescript": "^5.5.4",
    "vite": "^8.1.0",
    "wxt": "^0.20.26"
  },
  "engines": {
    "node": ">=24"
  }
}
